{
	"name": "agentdeck-streamdeck-plus",
	"version": "0.0.1",
	"description": "AgentDeck — control and monitor AI coding agents from an Elgato Stream Deck Plus.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.5.1"
	},
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.agentdeck.streamdeck-plus\"",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"icons": "node scripts/generate-icons.mjs",
		"codex:generate-types": "node scripts/generate-codex-types.mjs",
		"verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-commonjs": "^28.0.6",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.1.4",
		"@types/node": "^22.15.3",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.6.2",
		"rollup": "^4.52.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0",
		"vitest": "^4.0.0"
	}
}
