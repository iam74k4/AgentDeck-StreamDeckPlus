{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ES2022",
		"moduleResolution": "bundler",
		"types": ["node"],

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,

		"sourceMap": true,
		"declaration": false,
		"noEmit": true,
		"importHelpers": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,

		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "*.ts", "*.mts"],
	"exclude": ["node_modules", "com.agentdeck.streamdeck-plus.sdPlugin"]
}
